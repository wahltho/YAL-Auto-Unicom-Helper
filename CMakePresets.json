{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "binaryDir": "/Users/wahltho/dev/YAL Auto-Unicom Helper/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XPLANE_SDK_PATH": "$env{XPLANE_SDK_PATH}"
      }
    },
    {
      "name": "build-mac",
      "inherits": "release-base",
      "generator": "Ninja"
    },
    {
      "name": "build-win",
      "inherits": "release-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-mac",
      "configurePreset": "build-mac"
    },
    {
      "name": "build-win",
      "configurePreset": "build-win"
    }
  ]
}
