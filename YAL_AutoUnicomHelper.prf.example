# YAL Auto-Unicom Helper
# Productive transport is intentionally disabled by default.
AUTO_UNICOM_MODE=off
# Must exactly match the callsign used to connect Altitude.
ALTITUDE_CALLSIGN=
AUTO_UNICOM_FREQUENCY_KHZ=122800
ALTITUDE_WINDOW_TITLE=IVAO Pilot Client: Altitude
AUTO_UNICOM_MESSAGE_FIELD_NAME=Message
AUTO_UNICOM_SEND_BUTTON_TEXT=SEND
AUTO_UNICOM_CONFIRM_TIMEOUT_MS=5000
AUTO_UNICOM_GATE_MAX_AGE_MS=2500
AUTO_UNICOM_FINAL_GATE_TIMEOUT_MS=2500
UIA_RETRY_MS=100
DEBUG_UIA=0

# Optional guard for Altitude's persisted microphone and output endpoints.
# Enable only after both MATCH values resolve uniquely on this computer.
ALTITUDE_AUDIO_GUARD=0
ALTITUDE_AUDIO_INPUT=
ALTITUDE_AUDIO_OUTPUT=
ALTITUDE_AUDIO_INPUT_MATCH=
ALTITUDE_AUDIO_OUTPUT_MATCH=

AUTO_UNICOM_CHIME=1
AUTO_UNICOM_CHIME_FILE=resources/auto_unicom_chime.wav

# off | local | radio
AUTO_UNICOM_VOICE_MODE=off
# Radio endpoint feeding Altitude's configured microphone input.
AUTO_UNICOM_VOICE_OUTPUT=
AUTO_UNICOM_VOICE_OUTPUT_MATCH=
# Local/readback endpoint. Empty uses the Windows default output.
AUTO_UNICOM_VOICE_LOCAL_OUTPUT=
AUTO_UNICOM_VOICE_LOCAL_OUTPUT_MATCH=
# Empty uses the Windows default SAPI voice.
AUTO_UNICOM_VOICE_SAPI_VOICE=
AUTO_UNICOM_VOICE_SAPI_RATE=0
AUTO_UNICOM_VOICE_VOLUME=100
AUTO_UNICOM_VOICE_PTT_LEAD_MS=250
AUTO_UNICOM_VOICE_PTT_TAIL_MS=250
AUTO_UNICOM_VOICE_RECEIVE_WAIT_MS=30000
AUTO_UNICOM_VOICE_RECEIVE_QUIET_MS=1000
AUTO_UNICOM_VOICE_PTT_CONFIRM_MS=2500
AUTO_UNICOM_VOICE_TEST_TEXT=Auto Unicom voice audio test
PTT_KEY=LCTRL
